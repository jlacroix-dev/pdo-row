<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="pdo-row">
    <description>PHP_CodeSniffer configuration for pdo-row.</description>

    <file>bin</file>
    <file>scripts</file>
    <file>src</file>
    <file>templates</file>
    <file>tests</file>

    <arg name="extensions" value="php"/>

    <arg value="sp"/>
    <arg name="colors"/>

    <arg name="warning-severity" value="1"/>

    <rule ref="PSR12"/>
</ruleset>
{
  "name": "jlacroix-dev/pdo-row",
  "description": "Generate typed class for PDO fetchObject",
  "type": "library",
  "license": [
    "MIT"
  ],
  "keywords": [
    "dev",
    "pdo",
    "row",
    "dto"
  ],
  "homepage": "https://github.com/jlacroix-dev/pdo-row",
  "authors": [
    {
      "name": "Jonathan Lacroix",
      "email": "jlacroix.dev@gmail.com"
    }
  ],
  "require": {
    "ext-pdo": "*"
  },
  "require-dev": {
    "phpstan/phpstan": "2.2.5",
    "phpstan/phpstan-phpunit": "^2.0",
    "phpstan/phpstan-strict-rules": "^2.0",
    "phpunit/phpunit": "^13.3",
    "rector/rector": "^2.5",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "autoload": {
    "psr-4": {
      "JlacroixDev\\PdoRow\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\Unit\\": "tests/Unit/",
      "Tests\\Integration\\": "tests/Integration/"
    },
    "files": [
      "src/functions/helpers.php"
    ]
  },
  "bin": [
    "bin/pdo-row"
  ],
  "scripts": {
    "test": [
      "@test:unit",
      "@test:integration"
    ],
    "test:unit": "phpunit --testsuite unit",
    "test:integration:sqlite:setup": "bash tests/bin/setup-integration-sqlite.sh",
    "test:integration:mysql:setup": "bash tests/bin/setup-integration-mysql.sh",
    "test:integration:setup": [
      "@test:integration:sqlite:setup",
      "@test:integration:mysql:setup"
    ],
    "test:integration": [
      "@test:integration:setup",
      "phpunit --testsuite integration"
    ],
    "phpstan": "phpstan analyse",
    "rector": "rector",
    "phpcs": "phpcs --standard=phpcs.xml",
    "phpcbf": "phpcbf --standard=phpcbf.xml",
    "ci": [
      "@phpcs",
      "rector process --dry-run",
      "@phpstan",
      "@test"
    ],
    "fix": [
      "@phpcbf",
      "@rector"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
